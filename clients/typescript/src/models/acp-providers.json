{
  "claude-code": {
    "agent_name_patterns": [
      "claude-agent"
    ],
    "api_key_env_var": "ANTHROPIC_API_KEY",
    "base_url_env_var": "ANTHROPIC_BASE_URL",
    "binary_name": "claude-agent-acp",
    "data_dir_env_var": "CLAUDE_CONFIG_DIR",
    "default_command": [
      "npx",
      "-y",
      "--prefer-offline",
      "@agentclientprotocol/claude-agent-acp@0.63.0"
    ],
    "default_session_mode": "bypassPermissions",
    "display_name": "Claude Code",
    "env_conflicts": [
      {
        "dominant": "CLAUDE_CODE_OAUTH_TOKEN",
        "strip": [
          "ANTHROPIC_API_KEY",
          "ANTHROPIC_BASE_URL"
        ]
      }
    ],
    "file_secrets": [],
    "key": "claude-code",
    "session_meta_key": "claudeCode",
    "supports_runtime_model_switch": true,
    "supports_set_session_model": true
  },
  "codex": {
    "agent_name_patterns": [
      "codex-acp"
    ],
    "api_key_env_var": "OPENAI_API_KEY",
    "base_url_env_var": "OPENAI_BASE_URL",
    "binary_name": "codex-acp",
    "data_dir_env_var": "CODEX_HOME",
    "default_command": [
      "npx",
      "-y",
      "--prefer-offline",
      "@agentclientprotocol/codex-acp@2.2.2"
    ],
    "default_session_mode": "agent-full-access",
    "display_name": "Codex",
    "env_conflicts": [],
    "file_secrets": [
      {
        "env_points_to": "dir",
        "env_var": "CODEX_HOME",
        "filename": "auth.json",
        "secret_name": "CODEX_AUTH_JSON",
        "subdir": "codex",
        "warn_if_unset": []
      }
    ],
    "key": "codex",
    "session_meta_key": null,
    "supports_runtime_model_switch": true,
    "supports_set_session_model": true
  },
  "gemini-cli": {
    "agent_name_patterns": [
      "gemini-cli"
    ],
    "api_key_env_var": "GEMINI_API_KEY",
    "base_url_env_var": "GEMINI_BASE_URL",
    "binary_name": "gemini",
    "data_dir_env_var": "HOME",
    "default_command": [
      "npx",
      "-y",
      "--prefer-offline",
      "@google/gemini-cli@0.46.0",
      "--acp"
    ],
    "default_session_mode": "default",
    "display_name": "Gemini CLI",
    "env_conflicts": [],
    "file_secrets": [
      {
        "env_points_to": "file",
        "env_var": "GOOGLE_APPLICATION_CREDENTIALS",
        "filename": "gcloud-credentials.json",
        "secret_name": "GOOGLE_APPLICATION_CREDENTIALS_JSON",
        "subdir": "gemini-cli",
        "warn_if_unset": [
          "GOOGLE_CLOUD_PROJECT",
          "GOOGLE_CLOUD_LOCATION"
        ]
      }
    ],
    "key": "gemini-cli",
    "session_meta_key": null,
    "supports_runtime_model_switch": true,
    "supports_set_session_model": true
  },
  "kimi-code": {
