{
  "claude-code": {
    "agent_name_patterns": [
      "claude-agent"
    ],
    "api_key_env_var": "ANTHROPIC_API_KEY",
    "available_models": [
      {
        "id": "default",
        "label": "Default (recommended)"
      },
      {
        "id": "opus[1m]",
        "label": "Claude Opus (1M)"
      },
      {
        "id": "claude-opus-5",
        "label": "Claude Opus 5"
      },
      {
        "id": "sonnet",
        "label": "Claude Sonnet"
      },
      {
        "id": "haiku",
        "label": "Claude Haiku"
      }
    ],
    "base_url_env_var": "ANTHROPIC_BASE_URL",
    "binary_name": "claude-agent-acp",
    "data_dir_env_var": "CLAUDE_CONFIG_DIR",
    "default_command": [
      "npx",
      "-y",
      "--prefer-offline",
      "@agentclientprotocol/claude-agent-acp@0.63.0"
    ],
    "default_model": "opus[1m]",
    "default_session_mode": "bypassPermissions",
    "display_name": "Claude Code",
    "env_conflicts": [
      {
        "dominant": "CLAUDE_CODE_OAUTH_TOKEN",
        "strip": [
          "ANTHROPIC_API_KEY",
          "ANTHROPIC_BASE_URL"
        ]
      }
    ],
    "file_secrets": [],
    "key": "claude-code",
    "session_meta_key": "claudeCode",
    "supports_runtime_model_switch": true,
    "supports_set_session_model": true
  },
  "codex": {
    "agent_name_patterns": [
      "codex-acp"
    ],
    "api_key_env_var": "OPENAI_API_KEY",
    "available_models": [
      {
        "id": "gpt-5.6-sol",
        "label": "GPT-5.6 Sol"
      },
      {
        "id": "gpt-5.6-terra",
        "label": "GPT-5.6 Terra"
      },
      {
        "id": "gpt-5.6-luna",
        "label": "GPT-5.6 Luna"
      },
      {
        "id": "gpt-5.5",
        "label": "GPT-5.5"
      }
    ],
    "base_url_env_var": "OPENAI_BASE_URL",
    "binary_name": "codex-acp",
    "data_dir_env_var": "CODEX_HOME",
    "default_command": [
      "npx",
      "-y",
      "--prefer-offline",
      "@agentclientprotocol/codex-acp@1.1.7"
    ],
    "default_model": "gpt-5.5",
    "default_session_mode": "agent-full-access",
    "display_name": "Codex",
    "env_conflicts": [],
    "file_secrets": [
      {
        "env_points_to": "dir",
        "env_var": "CODEX_HOME",
        "filename": "auth.json",
        "secret_name": "CODEX_AUTH_JSON",
        "subdir": "codex",
        "warn_if_unset": []
      }
    ],
    "key": "codex",
    "session_meta_key": null,
    "supports_runtime_model_switch": true,
    "supports_set_session_model": true
  },
  "gemini-cli": {
