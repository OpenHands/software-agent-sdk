{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "local-tools": {
      "type": "stdio",
      "command": "./bin/serve.sh",
      "args": [
        "--root",
        "${PLUGIN_ROOT}",
        "--cache",
        "${PLUGIN_DATA}/cache"
      ],
      "env": {
        "TOOLS_STATE": "${PLUGIN_DATA}/state",
        "TOOLS_LABEL": "literal ${NOT_A_PLACEHOLDER} text",
        "${PLUGIN_ROOT}": "keys are never expanded"
      },
      "cwd": "${PLUGIN_DATA}/work"
    },
    "remote-api": {
      "type": "streamable-http",
      "url": "https://api.example.com/mcp?root=${PLUGIN_ROOT}",
      "headers": {
        "Authorization": "Bearer ${PLUGIN_DATA}",
        "X-Plugin-Root": "${PLUGIN_ROOT}",
        "Host": "spoofed.example.com"
      }
    }
  }
}
