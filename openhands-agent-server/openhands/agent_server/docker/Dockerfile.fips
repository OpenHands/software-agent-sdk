# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE=ghcr.io/openhands/agent-server:latest-python
ARG OPENSSL_FIPS_VERSION=3.1.2
ARG OPENSSL_FIPS_SHA256=a0ce69b8b97ea6a35b96875235aa453b966ba3cba8af2de23657d8b6767d6539
ARG NODE_VERSION=24.21.0
ARG NODE_SHA256=a6f54defb6fd7c84f41dba13d61e78e9b4e0961712cf61f29715c05f5ced94fc
ARG BUILD_JOBS=4

FROM debian:trixie-slim AS fips-builder
ARG OPENSSL_FIPS_VERSION
ARG OPENSSL_FIPS_SHA256

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl perl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
# `make install_fips` honours $libdir, which is `lib64` on x86_64 (the target
# sets `multilib 64`) but plain `lib` on aarch64 (linux-aarch64 has no
# multilib). Resolve the module to one fixed path here so the COPY in the final
# stage is architecture-independent and works once this image is built for both
# architectures like the other agent-server variants.
RUN curl -fsSLo openssl.tar.gz \
        "https://github.com/openssl/openssl/releases/download/openssl-${OPENSSL_FIPS_VERSION}/openssl-${OPENSSL_FIPS_VERSION}.tar.gz" \
    && echo "${OPENSSL_FIPS_SHA256}  openssl.tar.gz" | sha256sum -c - \
    && tar -xzf openssl.tar.gz --strip-components=1 \
    && ./Configure enable-fips \
    && make -j"$(nproc)" \
    && make install_fips DESTDIR=/fips \
    && fips_module="$(find /fips -type f -path '*/ossl-modules/fips.so' -print -quit)" \
    && test -n "$fips_module" \
    && install -D -m 0444 "$fips_module" /fips-module/fips.so

FROM debian:trixie-slim AS node-fips-builder
ARG NODE_VERSION
ARG NODE_SHA256
ARG BUILD_JOBS

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl libicu-dev libssl-dev pkg-config python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN curl -fsSLo node.tar.xz \
        "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}.tar.xz" \
    && echo "${NODE_SHA256}  node.tar.xz" | sha256sum -c - \
    && tar -xJf node.tar.xz --strip-components=1 \
    && ./configure --shared-openssl --openssl-is-fips --with-intl=system-icu --without-inspector \
    && make -j"${BUILD_JOBS}" node

FROM ${BASE_IMAGE} AS binary-fips
USER root

COPY --from=node-fips-builder /src/out/Release/node /usr/local/bin/node-fips
COPY --from=fips-builder /fips-module/fips.so \
    /usr/local/lib/ossl-modules/fips.so
COPY --from=fips-builder /fips/usr/local/ssl/fipsmodule.cnf \
    /etc/ssl/fipsmodule.cnf
COPY openhands-agent-server/openhands/agent_server/docker/openssl-fips.cnf \
    /etc/ssl/openssl-fips.cnf
COPY openhands-agent-server/openhands/agent_server/docker/fips-entrypoint.sh \
    /usr/local/bin/fips-entrypoint

RUN apt-get update \
    && apt-get install -y --no-install-recommends libicu76 \
    && rm -rf /var/lib/apt/lists/* \
    && chmod 0555 /usr/local/bin/fips-entrypoint \
    && chmod 0444 /etc/ssl/fipsmodule.cnf /etc/ssl/openssl-fips.cnf \
    && OPENSSL_CONF=/etc/ssl/openssl-fips.cnf \
       OPENSSL_MODULES=/usr/local/lib/ossl-modules \
       openssl list -providers | grep -q 'OpenSSL FIPS Provider'

ENV OPENSSL_CONF=/etc/ssl/openssl-fips.cnf
ENV OPENSSL_MODULES=/usr/local/lib/ossl-modules

# FIPS mode is scoped to this image's own Node build rather than exported
# image-wide as an environment variable. Such a variable would be inherited by
# the non-FIPS Node processes the base image ships — the ACP Node 22 runtime
# under $ACP_NODE_DIR and OpenVSCode Server's bundled runtime — which link their
# own OpenSSL and fail at startup under `--enable-fips`.
RUN set -eux; \
    printf '%s\n' \
      '#!/bin/sh' \
      '# FIPS-enabled Node: see Dockerfile.fips for why this is a shim.' \
      'NODE_OPTIONS="--enable-fips --openssl-shared-config" exec /usr/local/bin/node-fips "$@"' \
      > /usr/local/bin/node; \
    chmod 0555 /usr/local/bin/node; \
    # Fail the build rather than ship an image whose primary Node cannot start.
    node --version; \
    node -e 'const c = require("crypto"); if (c.getFips() !== 1) process.exit(1)'

USER openhands
ENTRYPOINT ["fips-entrypoint"]
CMD ["/usr/local/bin/openhands-agent-server"]
